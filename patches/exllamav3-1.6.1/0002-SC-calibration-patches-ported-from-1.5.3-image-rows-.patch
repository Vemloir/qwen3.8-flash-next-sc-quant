+def embed_calibration_images(config, tokenizer, images, input_ids, device):
+    """
+    Embed the images of calibration rows with the unquantized vision tower and write their
+    multimodal embedding ids into the rows' input ids (in place), as the generator does for a
+    prompt with images. Returns {row: [MMEmbedding]} for the embedding module's indexed_embeddings.
+    """
+    import io
+    from PIL import Image
+    vision = Model.from_config(config, component = "vision")
+    vision.load(device = torch.device("cuda", device))
+    image_id = config.image_token_id
+    out = {}
+    for r, start, n, data in images:
+        mme = vision.get_image_embeddings(tokenizer, Image.open(io.BytesIO(data)).convert("RGB"))
+        ids = input_ids[r]
+        span = ids[0, start : start + n]
+        assert mme.mm_length == n, f"calibration row {r}: image at {start} has {n} positions, the vision tower gives {mme.mm_length}"
+        assert bool((span == image_id).all()), f"calibration row {r}: positions {start}..{start + n} are not image tokens"
+        span.copy_(torch.arange(mme.first_index, mme.first_index + n, dtype = ids.dtype))
+        out.setdefault(r, []).append(mme)
+    vision.unload()
+    free_mem()
+    print(f" -- Embedded {len(images)} calibration images in {len(out)} rows")
+    return out
