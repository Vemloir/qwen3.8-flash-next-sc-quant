+def drop_file_cache(path: str):
+    """
+    Flush a just-written file and evict it from the page cache. A checkpoint of the calibration state
+    is tens of GB: left as dirty page cache it counts against a memory-limited cgroup until writeback
+    catches up, on top of the state still held in RAM, and the next module load can push the job
+    over its limit.
+    """
+    fd = os.open(path, os.O_RDONLY)
+    try:
+        os.fsync(fd)
+        if hasattr(os, "posix_fadvise"):
+            os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED)
+    finally:
+        os.close(fd)
 
 
