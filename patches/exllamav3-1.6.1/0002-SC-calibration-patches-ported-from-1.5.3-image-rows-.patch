+class RowChunker:
+    """
+    Forward pass of one calibration row through one module in chunks, for rows too long to hold the
+    module's activations on the device at once. A cache attached to the model carries attention K/V
+    (and sparse-attention indexer keys) across chunks and a recurrent-state slot carries linear-attention
+    and PLE state, exactly as in a generator prefill split into chunks. Inputs and outputs stay in system
+    RAM. Agrees with the full-row forward to ~1e-3 relative (fp16 kernel accumulation order).
+    """
+
+    def __init__(self, model, chunk: int, max_len: int):
+        from ..cache import Cache
+        from ..constants import PAGE_SIZE
+        self.model = model
+        self.chunk = chunk
+        self.page = PAGE_SIZE
+        self.cache = Cache(model, max_num_tokens = self._cap(max_len), max_batch_size = 1)
+        # cache tensors are allocated as each module loads, not by a whole-model load
+        self.cache.initialized = True
+
+    def _cap(self, n):
+        return (n + self.page - 1) // self.page * self.page
+
+    def is_long(self, x):
+        # hidden states are (1, L, D) or, with hyper-connections, (1, L, streams, D)
+        return torch.is_tensor(x) and x.dim() >= 3 and x.shape[1] > self.chunk
+
+    @torch.inference_mode()
+    def forward(self, module, x, params, keep_output: bool = True, chunk: int | None = None):
+        """
+        Returns the module output for the whole row in system RAM (written chunk by chunk into one
+        preallocated tensor, so a long row is held at most twice: input and output), or None with
+        keep_output = False (capture passes only need the side effects). Non-finite values are
+        checked per chunk on the device; the result is left in self.last_finite.
+        """
+        from ..cache.recurrent_util import advance_recurrent_states
+        L = x.shape[1]
+        ids = params["input_ids"]
+        assert ids.shape[-1] == L, "input_ids do not match the row length"
+        cap = self._cap(L)
+        rstate = self.cache.get_new_state() if self.cache.recurrent_layers else None
+        out = None
+        self.last_finite = True
+        step = chunk or self.chunk
+        try:
+            for a in range(0, L, step):
+                b = min(a + step, L)
+                p = dict(params)
+                p.update({
+                    "attn_mode": "flash_attn",
+                    "cache": self.cache,
+                    "batch_shape": (1, cap),
+                    "past_len": a,
+                    "input_ids": ids[:, a:b],
+                })
+                if rstate is not None:
+                    p["recurrent_states"] = [rstate]
+                self.model.prepare_inputs(ids[:, a:b], p)
+                y = module.forward(module.prepare_for_device(x[:, a:b], p), p)
+                advance_recurrent_states(ids[:, a:b], p, self.model)
+                if not torch.isfinite(y).all().item():
+                    self.last_finite = False
+                if keep_output:
+                    if out is None:
+                        out = torch.empty((y.shape[0], L, *y.shape[2:]), dtype = y.dtype)
+                    out[:, a:b].copy_(y)
+                del y
+                if "quant_preserve" in p:
+                    params["quant_preserve"] = p["quant_preserve"]
+        finally:
+            if rstate is not None:
+                self.cache.release_state(rstate)
+        return out
+
