+def get_file_calibration_images(args):
+    """
+    Images of a packed calibration file, as a list of (row, start, length, image_bytes), or [] when
+    the file has none. Rows with images (written by trace_images.py) carry the model's image token
+    at the image's embedding positions: "mm_row", "mm_start" and "mm_len" give the row, the first
+    position and the number of embedding positions of each image, and "mm_image_<k>" holds the
+    k-th image file (PNG/JPEG bytes as uint8), so the calibration file is self-contained.
+    """
+    from safetensors.torch import load_file
+    data = load_file(args["cal_data"])
+    if "mm_row" not in data:
+        return []
+    rows = data["mm_row"].tolist()
+    keep = args["cal_rows"]
+    out = []
+    for k, (r, s, n) in enumerate(zip(rows, data["mm_start"].tolist(), data["mm_len"].tolist())):
+        if r < keep:
+            out.append((r, s, n, data[f"mm_image_{k}"].numpy().tobytes()))
+    return out
